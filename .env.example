# Copy to .env.local for local runs (`node --env-file=.env.local server.js`), and add the
# same keys in Render → your service → Environment. Never commit real values.

# https://lichess.org/account/oauth/token  (create a token; no scopes needed)
LICHESS_TOKEN=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
