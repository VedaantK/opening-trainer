# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# https://lichess.org/account/oauth/token  (create a token; no scopes needed)
LICHESS_TOKEN=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
